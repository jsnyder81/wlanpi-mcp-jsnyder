#!/bin/sh
set -e

CONFIG_DIR=/etc/wlanpi-mcp
CONFIG_FILE=$CONFIG_DIR/config.env

case "$1" in
    configure)
        # Create config directory if needed
        mkdir -p "$CONFIG_DIR"

        # Write default config on first install. Auth is JWT passthrough:
        # MCP clients send a wlanpi-core token as 'Authorization: Bearer'.
        if [ ! -f "$CONFIG_FILE" ]; then
            cat > "$CONFIG_FILE" <<EOF
WLANPI_CORE_URL=https://localhost:31415
WLANPI_CORE_CA=/etc/nginx/ssl/self-signed-wlanpi.cert
# Fallback wlanpi-core JWT for stdio transport only. In HTTP/daemon mode leave
# empty: clients must send their own token as 'Authorization: Bearer <token>'.
WLANPI_CORE_TOKEN=
WLANPI_MCP_HOST=127.0.0.1
WLANPI_MCP_PORT=8768
LOG_LEVEL=INFO
# Allow MCP clients to reboot/shut down the device. Set false to disable.
ALLOW_POWER_CONTROL=true
EOF
            echo ""
            echo "============================================================"
            echo "  WLAN Pi MCP Server installed"
            echo "  Clients authenticate with a wlanpi-core JWT:"
            echo "  POST https://<device>:31415/api/v1/auth/token"
            echo "  Then connect to https://<device>:8767/mcp (TLS)"
            echo "  or http://<device>:8766/mcp (plaintext fallback)"
            echo "============================================================"
            echo ""
        else
            # Upgrade: migrate HTTP default URL to HTTPS if still at the old value.
            sed -i 's|^WLANPI_CORE_URL=http://localhost:31415$|WLANPI_CORE_URL=https://localhost:31415|' "$CONFIG_FILE"
            # Add WLANPI_CORE_CA if not already present.
            if ! grep -q '^WLANPI_CORE_CA=' "$CONFIG_FILE"; then
                echo 'WLANPI_CORE_CA=/etc/nginx/ssl/self-signed-wlanpi.cert' >> "$CONFIG_FILE"
            fi
            # Upgrade: the daemon is fronted by nginx (TLS on 8767,
            # plaintext fallback on 8766). It must bind loopback-only, or its
            # port collides with nginx's listeners (EADDRINUSE) and the service
            # fails to start. Chain the migrations so a device on any prior
            # version lands on the current loopback upstream port 8768.
            sed -i 's|^WLANPI_MCP_HOST=0.0.0.0$|WLANPI_MCP_HOST=127.0.0.1|' "$CONFIG_FILE"
            sed -i 's|^WLANPI_MCP_PORT=8766$|WLANPI_MCP_PORT=8768|' "$CONFIG_FILE"
            sed -i 's|^WLANPI_MCP_PORT=8767$|WLANPI_MCP_PORT=8768|' "$CONFIG_FILE"
        fi

        chmod 640 "$CONFIG_FILE"
        chown root:wlanpi "$CONFIG_FILE" 2>/dev/null || true

        # Open the MCP ports in UFW via the shipped application profile
        # (/etc/ufw/applications.d/wlanpi-mcp). The setup script installs the
        # profile and runs `ufw allow wlanpi-mcp`; 8766/8767 are defined in
        # /etc/wlanpi-mcp/ufw/wlanpi-mcp.rules, adjust there if the ports change.
        # In a chroot (image build) ufw isn't active; the first-boot oneshot
        # (enabled by dh_installsystemd, see debian/rules) applies the rules on
        # boot instead.
        if ! ischroot && [ -x /etc/wlanpi-mcp/ufw/wlanpi-mcp-ufw-rules-setup.sh ]; then
            /etc/wlanpi-mcp/ufw/wlanpi-mcp-ufw-rules-setup.sh || true
        fi

        # Reload nginx to pick up the MCP TLS site front. Skip when the
        # self-signed cert (generated by wlanpi-core's postinst) or nginx is
        # not available yet, e.g. during image-build chroots where neither runs;
        # core's postinst starts nginx on first real boot.
        if [ -f /etc/nginx/ssl/self-signed-wlanpi.cert ] && \
           [ -f /etc/nginx/sites-enabled/wlanpi-mcp.conf ]; then
            if which nginx >/dev/null 2>&1; then
                echo "Validating nginx configuration..."
                if nginx -t; then
                    if systemctl is-active --quiet nginx.service; then
                        echo "Reloading nginx..."
                        deb-systemd-invoke reload nginx.service || true
                    fi
                fi
            fi
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
