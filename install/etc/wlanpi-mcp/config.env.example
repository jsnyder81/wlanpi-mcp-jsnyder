WLANPI_CORE_URL=https://localhost:31415
# CA for wlanpi-core's TLS listener (self-signed, generated by wlanpi-core).
WLANPI_CORE_CA=/etc/nginx/ssl/self-signed-wlanpi.cert
# WLANPI_CORE_TOKEN (the stdio-mode fallback JWT) is deliberately not read from
# this file: pass it in the process environment instead. In HTTP/daemon mode
# clients send their own token as 'Authorization: Bearer <token>'.
# Loopback-only: nginx fronts the MCP daemon on 8767 (TLS, preferred) and 8766
# (plaintext fallback for harnesses that cannot validate the self-signed cert,
# e.g. goose). Clients connect to https://<wlanpi>:8767/mcp or
# http://<wlanpi>:8766/mcp. 8768 is the internal upstream.
WLANPI_MCP_HOST=127.0.0.1
WLANPI_MCP_PORT=8768
LOG_LEVEL=INFO
# Allow MCP clients to reboot/shut down the device. Set false to disable.
ALLOW_POWER_CONTROL=true
# Tool exposure: "full" (every tool) or "classroom" (reads, scans, captures).
TOOL_PROFILE=full
# Comma-separated tool names; when set, overrides TOOL_PROFILE exactly.
TOOL_ALLOWLIST=
